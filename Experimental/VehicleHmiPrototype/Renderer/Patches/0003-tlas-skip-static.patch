+                Min0 = this.ScratchMinX[K];  Min1 = this.ScratchMinY[K];  Min2 = this.ScratchMinZ[K];
+                Max0 = this.ScratchMaxX[K];  Max1 = this.ScratchMaxY[K];  Max2 = this.ScratchMaxZ[K];
+                Cen0 = this.ScratchCentX[K]; Cen1 = this.ScratchCentY[K]; Cen2 = this.ScratchCentZ[K];
+                Occ  = this.ScratchOccIdx[K];
+            }
+            else
+            {
+                const Box = Scene.QueryWorldBounds(GroundIdx);
+                Min0 = Box.Minimum[0]; Min1 = Box.Minimum[1]; Min2 = Box.Minimum[2];
+                Max0 = Box.Maximum[0]; Max1 = Box.Maximum[1]; Max2 = Box.Maximum[2];
+                Occ  = GroundIdx;
