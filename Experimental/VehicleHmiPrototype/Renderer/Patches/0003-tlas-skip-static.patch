+    //    is ground, is the ground occupant, which the build writes from its bounds alone. The centroid is in the key because the SAH split reads
+    //    it: bounds that agree as floats can still centre either side of a bin edge, and the skip must only ever leave the tree a rebuild would
+    //    have made. Exact equality; a NaN is never equal, so it always builds.
+    TlasInputsMatch(Scene, ObjectCount, HasGround, GroundIdx)
+    {
+        const Count    = ObjectCount + (HasGround ? 1 : 0);
+        const Capacity = this.ScratchOccIdx.length + 1;
+        if (!this.TlasKeyBounds || this.TlasKeyBounds.length < Capacity * 9)
+        {
+            this.TlasKeyBounds   = new Float64Array(Capacity * 9);
+            this.TlasKeyIdentity = new Int32Array(Capacity * 2);
+            this.TlasKeyCount    = -1;
+        }
+        const Bounds   = this.TlasKeyBounds;
+        const Identity = this.TlasKeyIdentity;
+        let Same = this.TlasKeyCount === Count;
+        for (let K = 0; K < Count; ++K)
+        {
