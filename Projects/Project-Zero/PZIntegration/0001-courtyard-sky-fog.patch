+AtmosphereSpanStructure AtmosphereSpanMake(float t0, float t1, float ground)
+{
+    AtmosphereSpanStructure s;
+    s.t0 = t0;
+    s.t1 = t1;
+    s.ground = ground;
+    return s;
+}
