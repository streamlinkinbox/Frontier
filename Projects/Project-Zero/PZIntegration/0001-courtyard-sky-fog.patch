+bool RendererHost::ExportCourtyardImage(const std::string& OutputPath) const noexcept
+{
+    std::ofstream Out(OutputPath, std::ios::binary);
+    if (!Out.is_open())
+    {
+        return false;
+    }
+
+    Out << "P6\n" << Width << " " << Height << "\n255\n";
+
+    // The gated panel post chain (exposure, tonemap, vignette) so the
+    // courtyard matches the harness proof frames pixel-structure.
+    for (uint32_t y = 0; y < Height; ++y)
+    {
+        for (uint32_t x = 0; x < Width; ++x)
+        {
+            size_t idx = y * Width + x;
+            Vector3 Display = SkyFog.ApplyPanelPost(AccumulatedBuffer[idx], x, y, Width, Height);
+
+            uint8_t R8 = static_cast<uint8_t>(std::clamp(Display.x * 255.0f, 0.0f, 255.0f));
+            uint8_t G8 = static_cast<uint8_t>(std::clamp(Display.y * 255.0f, 0.0f, 255.0f));
+            uint8_t B8 = static_cast<uint8_t>(std::clamp(Display.z * 255.0f, 0.0f, 255.0f));
+
+            Out.put(static_cast<char>(R8));
+            Out.put(static_cast<char>(G8));
+            Out.put(static_cast<char>(B8));
+        }
+    }
+
+    return true;
+}
