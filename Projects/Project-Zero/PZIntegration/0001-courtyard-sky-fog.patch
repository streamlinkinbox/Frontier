+//@@BAN: STRUCTURE FACTORIES
+AtmosphereStructure AtmosphereStructureMake(float3 sky, float3 trans, float ground, float odR, float odM)
+{
+    AtmosphereStructure o;
+    o.sky = sky;
+    o.trans = trans;
+    o.ground = ground;
+    o.odR = odR;
+    o.odM = odM;
