+    Nodes[static_cast<size_t>(NodeIdx)].ChildRight = Right;
+    Nodes[static_cast<size_t>(NodeIdx)].StartIndex = -1;
+    Nodes[static_cast<size_t>(NodeIdx)].PrimCount = 0;
+    return NodeIdx;
+}
