+// Writes presented LDR bytes back out as a PPM file so a windowed
+// session keeps the same artifact a headless run produces.
+bool ExportLdrPpm(const std::string& OutputPath, const std::vector<uint8_t>& Rgba, uint32_t Width, uint32_t Height) noexcept
+{
+    if (Width < 8 || Height < 8
+        || Rgba.size() < static_cast<size_t>(Width) * static_cast<size_t>(Height) * 4U)
+    {
+        return false;
+    }
+    std::FILE* Out = std::fopen(OutputPath.c_str(), "wb");
+    if (Out == nullptr)
+    {
+        return false;
+    }
+    std::fprintf(Out, "P6\n%u %u\n255\n", Width, Height);
+    size_t PixelCount = static_cast<size_t>(Width) * static_cast<size_t>(Height);
+    for (size_t i = 0; i < PixelCount; ++i)
+    {
+        uint8_t Triplet[3] = { Rgba[i * 4U + 0U], Rgba[i * 4U + 1U], Rgba[i * 4U + 2U] };
+        if (std::fwrite(Triplet, 1U, 3U, Out) != 3U)
+        {
+            std::fclose(Out);
+            return false;
+        }
+    }
+    std::fclose(Out);
+    return true;
+}
