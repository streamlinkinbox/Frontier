+void RenderWorkerLoop(RenderMailbox& Mailbox, std::atomic<bool>& ExitRequested,
+    std::atomic<uint64_t>& LastRenderMilliseconds, RenderParameters Params) noexcept
+{
+    std::unique_ptr<Frontier::ProjectZero::RendererHost> Renderer =
