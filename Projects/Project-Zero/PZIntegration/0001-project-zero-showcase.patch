+            std::this_thread::sleep_for(std::chrono::milliseconds(10));
+            continue;
+        }
+
+        WorkerCamera.AssignSpatialLocation(Snap.Location);
+        WorkerCamera.AssignOrientationEuler(Snap.PitchRadians, Snap.YawRadians, 0.0f);
+        WorkerCamera.AssignFieldOfView(Snap.FieldOfViewDegrees);
+        WorkerCamera.AssignAspectRatio(Snap.AspectRatio);
+
