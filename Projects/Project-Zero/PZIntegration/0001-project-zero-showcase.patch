+    p.pixAngle = 0.0f;
+    // Showcase sky: full moon, broken cirrus, boosted stars (artistic
+    // license for the group photo; the mirror gates keep these off).
+    p.moonOn = 1u;
+    p.moonDir = float3(0.2506f, 0.3509f, -0.9023f);
+    p.moonBright = 3.0f;
+    p.cloudOn = 1u;
+    p.cloudCoverage = 0.28f;
