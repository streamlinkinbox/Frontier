+// CPU-frame presenter: blits the renderer's LDR bytes into the native
+// window through GDI. No GPU context needed — the showcase is a CPU
+// path tracer, so the window is a dumb framebuffer viewer.
+void PresentRgbaToWindow(void* NativeWindowToken, const std::vector<uint8_t>& Rgba, uint32_t Width, uint32_t Height,
+    std::vector<uint8_t>& ScratchPad) noexcept
+{
+    HWND WindowHandle = static_cast<HWND>(NativeWindowToken);
+    if (WindowHandle == nullptr || Width < 8 || Height < 8
+        || Rgba.size() < static_cast<size_t>(Width) * static_cast<size_t>(Height) * 4U)
+    {
+        return;
+    }
+    HDC DeviceContext = GetDC(WindowHandle);
+    if (DeviceContext == nullptr)
+    {
+        return;
+    }
+
+    // GDI 32-bit BI_RGB expects byte order B,G,R,unused; swizzle once.
+    ScratchPad.resize(Rgba.size());
+    for (size_t i = 0; i + 3U < Rgba.size() + 1U; i += 4U)
+    {
+        ScratchPad[i + 0U] = Rgba[i + 2U];
+        ScratchPad[i + 1U] = Rgba[i + 1U];
+        ScratchPad[i + 2U] = Rgba[i + 0U];
+        ScratchPad[i + 3U] = 0U;
+    }
+
+    BITMAPINFO BitmapInfo{};
+    BitmapInfo.bmiHeader.biSize = sizeof(BITMAPINFOHEADER);
+    BitmapInfo.bmiHeader.biWidth = static_cast<LONG>(Width);
+    BitmapInfo.bmiHeader.biHeight = -static_cast<LONG>(Height);
+    BitmapInfo.bmiHeader.biPlanes = 1U;
+    BitmapInfo.bmiHeader.biBitCount = 32U;
+    BitmapInfo.bmiHeader.biCompression = BI_RGB;
+    (void)StretchDIBits(DeviceContext, 0, 0, static_cast<int>(Width), static_cast<int>(Height),
+        0, 0, static_cast<int>(Width), static_cast<int>(Height),
+        ScratchPad.data(), &BitmapInfo, DIB_RGB_COLORS, SRCCOPY);
+    (void)ReleaseDC(WindowHandle, DeviceContext);
+}
