+        Renderer->RenderShowcaseFrame(WorkerCamera, Params.SunHour, Params.FogChoice,
+            Params.SpatialPasses, Params.BounceCount, Params.FlareEnabled, Params.FlareVariety);
+        auto EndTime = std::chrono::high_resolution_clock::now();
+        uint64_t DurationMs =
+            static_cast<uint64_t>(std::chrono::duration<double, std::milli>(EndTime - StartTime).count());
+
+        std::vector<uint8_t> LdrRgba;
+        Renderer->ExportLdrPixels(LdrRgba);
