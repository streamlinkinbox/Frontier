+            Mailbox.FinishedHeight = Renderer->QueryHeight();
+            Mailbox.Finished = std::move(LdrRgba);
+            ++Mailbox.FinishedId;
+        }
+        LastRenderMilliseconds.store(DurationMs);
+    }
