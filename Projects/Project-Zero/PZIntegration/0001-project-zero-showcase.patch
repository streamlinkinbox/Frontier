+        bool DoRender = false;
+        bool DoResize = false;
+        CameraSnapshot Snap{};
+        uint32_t SnapWidth = 0;
+        uint32_t SnapHeight = 0;
+        {
+            std::lock_guard<std::mutex> Lock(Mailbox.Mutex);
+            if (Mailbox.ResizeDirty)
+            {
+                SnapWidth = Mailbox.PendingWidth;
+                SnapHeight = Mailbox.PendingHeight;
