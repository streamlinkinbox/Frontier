+//------------------------------------------------------------------------------------------------------------------------
+//                                                 CLOUD SHADOW FIELD
+//------------------------------------------------------------------------------------------------------------------------
+
+// Coverage maps from CloudTextures/GenerateCloudTextures.py (binary PPM P6,
+// grayscale-in-RGB). World frame is Z-up: the deck is the plane z = Height; a
+// surface point P projects ALONG THE SUN RAY to Q = P + sun * ((H - P.z)/sun.z)
+// and the maps are wrap-sampled at Q.xy/Repeat + wind*Time/Repeat. The formula
+// below MUST match the GPU side (PostRecords.slang CloudShadowAt plus the
+// CelestialSequence cloud pack) constant for constant.
+
+constexpr float   CloudPlaneHeightM  = 500.0f;                  // [m] shadow-casting deck altitude
+constexpr float   CloudRepeatM       = 180.0f;                  // [m] world size of one coverage tile
+constexpr float   CloudWindXMps      = 8.0f;                    // [m/s] deck drift, world +X (east)
+constexpr float   CloudWindYMps      = 3.0f;                    // [m/s] deck drift, world +Y (north)
+constexpr float   CloudShadeStrength = 0.75f;                   // [-] sun kept at full overcast: 1 - 0.75
+constexpr float   CloudDetailScale   = 6.0f;                    // [-] detail-map repeat inside one tile
+constexpr float   CloudDetailBiasU   = 0.37f;                   // [-] detail offset so its cells never align
+constexpr float   CloudDetailBiasV   = 0.73f;                   // [-] with the coverage lattice
+
+bool                    CloudEnabled = true;                    // [-] master switch, default ON
+float                   CloudTimeSec = 0.0f;                  // [s] fixed showcase instant (GPU: live clock)
+std::vector<uint8_t>    CloudCoverage;                          // [-] coverage texels, 0..255
+uint32_t                CloudCoverageSize = 0;                  // [px] coverage edge (square)
+std::vector<uint8_t>    CloudDetail;                            // [-] breakup texels, 0..255
+uint32_t                CloudDetailSize = 0;                    // [px] detail edge (square)
+
+bool LoadCoveragePpm(const char* Path, std::vector<uint8_t>& Texels, uint32_t& Edge) noexcept
+{
+    Texels.clear();
+    Edge = 0;
+    if (Path == nullptr || Path[0] == '\0')
+    {
+        return false;
+    }
+    FILE* File = std::fopen(Path, "rb");
+    if (File == nullptr)
+    {
+        return false;
+    }
+    char Magic[2] = { 0, 0 };
+    bool Ok = std::fread(Magic, 1, 2, File) == 2 && Magic[0] == 'P' && Magic[1] == '6';
+    long Values[3] = { 0, 0, 0 };
+    for (int v = 0; v < 3 && Ok; ++v)
+    {
+        int c = 0;
+        do
+        {
+            c = std::fgetc(File);
+            if (c == '#')
+            {
+                do { c = std::fgetc(File); } while (c != '\n' && c != EOF);
+            }
+            if (c == EOF) { Ok = false; break; }
+        } while (c != '-' && (c < '0' || c > '9'));
+        long Accum = 0;
+        bool Negative = false;
+        if (Ok && c == '-') { Negative = true; c = std::fgetc(File); }
+        while (Ok && c >= '0' && c <= '9') { Accum = Accum * 10 + (c - '0'); c = std::fgetc(File); }
+        if (c == EOF) { Ok = false; }
+        Values[v] = Negative ? -Accum : Accum;
+    }
+    // P6 stores RGB triples; the generator writes gray, so the red channel is the density.
+    if (Ok && (Values[0] <= 0 || Values[0] > 4096 || Values[0] != Values[1] || Values[2] != 255))
+    {
+        Ok = false;
+    }
+    if (Ok)
+    {
+        const uint32_t EdgePx = static_cast<uint32_t>(Values[0]);
+        Texels.resize(static_cast<size_t>(EdgePx) * EdgePx);
+        for (uint32_t i = 0; i < EdgePx * EdgePx && Ok; ++i)
+        {
+            int R = std::fgetc(File);
+            int G = std::fgetc(File);
+            int B = std::fgetc(File);
+            if (R == EOF || G == EOF || B == EOF) { Ok = false; break; }
+            (void)G; (void)B;
+            Texels[i] = static_cast<uint8_t>(R);
+        }
+        if (Ok) { Edge = EdgePx; }
+    }
+    if (!Ok) { Texels.clear(); Edge = 0; }
+    std::fclose(File);
+    return Ok;
+}
+
+float SampleCloudWrapped(const std::vector<uint8_t>& Texels, uint32_t Edge, float U, float V) noexcept
+{
+    if (Texels.empty() || Edge == 0)
+    {
+        return 0.0f;
+    }
+    const float Dim = static_cast<float>(Edge);
+    float X = std::fmod(U * Dim - 0.5f, Dim);
+    float Y = std::fmod(V * Dim - 0.5f, Dim);
+    if (X < 0.0f) { X += Dim; }
+    if (Y < 0.0f) { Y += Dim; }
+    const uint32_t X0 = static_cast<uint32_t>(X);
+    const uint32_t Y0 = static_cast<uint32_t>(Y);
+    const uint32_t X1 = (X0 + 1u) % Edge;
+    const uint32_t Y1 = (Y0 + 1u) % Edge;
+    const float Fx = X - static_cast<float>(X0);
+    const float Fy = Y - static_cast<float>(Y0);
+    const float A = static_cast<float>(Texels[static_cast<size_t>(Y0) * Edge + X0]);
+    const float B = static_cast<float>(Texels[static_cast<size_t>(Y0) * Edge + X1]);
+    const float C = static_cast<float>(Texels[static_cast<size_t>(Y1) * Edge + X0]);
+    const float D = static_cast<float>(Texels[static_cast<size_t>(Y1) * Edge + X1]);
+    return (A + (B - A) * Fx + (C - A) * Fy + (A - B - C + D) * Fx * Fy) * (1.0f / 255.0f);
+}
+
 } // namespace
 
