+void SkyFogIntegrator::AssignCloudShadow(bool Enabled, float CloudTimeSeconds, const char* CoveragePath, const char* DetailPath) noexcept
+{
+    CloudEnabled = Enabled;
+    CloudTimeSec = CloudTimeSeconds;
+    bool OkCoverage = false;
+    bool OkDetail = false;
+    try
+    {
+        OkCoverage = LoadCoveragePpm(CoveragePath, CloudCoverage, CloudCoverageSize);
+        OkDetail = LoadCoveragePpm(DetailPath, CloudDetail, CloudDetailSize);
+    }
+    catch (...)
+    {
+        OkCoverage = false;
+        OkDetail = false;
+    }
+    if (!OkCoverage)
+    {
+        // A missing coverage map must never crash the showcase: shadows fail open (multiplier 1).
+        CloudCoverage.clear();
+        CloudCoverageSize = 0;
+        CloudEnabled = false;
+        std::printf("[Project-Zero] CloudShadow: cannot load %s — cloud shadows OFF.\n",
+                    CoveragePath != nullptr ? CoveragePath : "(null)");
+        return;
+    }
+    if (!OkDetail)
+    {
+        // Detail is garnish: flat mid-gray keeps the coverage mean-neutral (0.65 + 0.7 * 0.5 = 1.0).
+        CloudDetail.assign(1, 128);
+        CloudDetailSize = 1;
+        std::printf("[Project-Zero] CloudShadow: cannot load %s — breakup disabled.\n",
+                    DetailPath != nullptr ? DetailPath : "(null)");
+    }
+    std::printf("[Project-Zero] CloudShadow: %s, field %s (%u px), t = %.1f s.\n",
+                CloudEnabled ? "ON" : "OFF", CoveragePath, CloudCoverageSize, CloudTimeSec);
+}
+
+float SkyFogIntegrator::QueryCloudShadow(const Vector3& WorldPos, const Vector3& SunWorldDir) const noexcept
+{
+    if (!CloudEnabled || CloudCoverage.empty() || SunWorldDir.z <= 1e-4f)
+    {
+        return 1.0f;
+    }
+    // Up the sun ray to the deck, then wrap-sample. Mirrors PostRecords.slang CloudShadowAt.
+    const float T = (CloudPlaneHeightM - WorldPos.z) / SunWorldDir.z;
+    const float Qx = WorldPos.x + SunWorldDir.x * T;
+    const float Qy = WorldPos.y + SunWorldDir.y * T;
+    const float U = (Qx + CloudWindXMps * CloudTimeSec) / CloudRepeatM;
+    const float V = (Qy + CloudWindYMps * CloudTimeSec) / CloudRepeatM;
+    float Coverage = SampleCloudWrapped(CloudCoverage, CloudCoverageSize, U, V);
+    const float Detail = SampleCloudWrapped(CloudDetail, CloudDetailSize,
+                                            U * CloudDetailScale + CloudDetailBiasU,
+                                            V * CloudDetailScale + CloudDetailBiasV);
+    Coverage = std::clamp(Coverage * (0.65f + 0.7f * Detail), 0.0f, 1.0f);
+    return 1.0f - CloudShadeStrength * Coverage;
+}
+
 Vector3 SkyFogIntegrator::QuerySunDirectionRender() const noexcept
 {
     return ToVector3(CoreSky.sunDir);

