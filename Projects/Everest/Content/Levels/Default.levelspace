# The proving ground's objects (the geometry inspector), each standing for occupants of the scene archive
# (EnvironmentArchives/ProvingGround) by name. A repeated set is one object with Array modifiers that lay its copies out
# exactly where the archive placed them; the archive origin is where the object's origin sits in the archive.

[[records]]
identity = "rec_geometry_proving_ground"
type = "Geometry"
name = "Proving ground"
[records.configuration]
occupants = ["Proving ground"]
archive_origin_m = [0.0, 0.0, 0.0]
archive_yaw_deg = 0.0
group = "Course"
glyph = "Map"
visible = true
dynamic = false
cast_shadows = true
global_illumination = true
physics = false
locked = true
position_m = [0.0, 0.0, 0.0]
orientation_deg = [0.0, 0.0, 0.0]
scale = [1.0, 1.0, 1.0]
fracture = false

[[records]]
identity = "rec_geometry_kerbs"
