secondary_enabled = true

[[records]]
identity = "rec_planet_venus"
type = "Planet"
name = "Venus"
[records.configuration]
enabled = true
body = 0
apparent_diameter_deg = 0.80
brightness = 1.0
ring_system = false
atmosphere_shell = true

[[records]]
identity = "rec_planet_jupiter"
type = "Planet"
name = "Jupiter"
[records.configuration]
enabled = true
body = 1
apparent_diameter_deg = 1.26
brightness = 1.0
ring_system = false
atmosphere_shell = false

[[records]]
