[level]
format_version = 1
name = "Everest — Lobby"

[[records]]
identity = "rec_pipeline"
type = "RenderPipeline"
name = "Render settings"
[records.configuration]
# The whole renderer in one record (Render settings inspector); every value below is the VehicleHMI demo's unless noted.
enabled = true
hardware_ray_query = true          # RTX ReSTIR path tracer; false: GTX distance-field GI
quality_tier = 2                   # 0 low, 1 medium, 2 high
analytic_illumination = false      # the fast closed-form preview instead of the global illumination (a debug view)
# Resolution & sampling
render_scale = 1.0                 # viewport scale, under the grade's pixel ceiling
trace_scale = 2                    # GI and reflections: 1 full, 2 half, 4 quarter
initial_candidates = 2             # paths per pixel (M)
# Global illumination
global_illumination = true
max_bounces = 3
multi_bounce_nee = true
russian_roulette = true
temporal_reuse = true
spatial_reuse = true
visibility_reuse = true
radiance_refresh = true
spatial_count = 5
spatial_radius = 20.0
temporal_tally_limit = 20.0
indirect_scale = 1.0
sky_scale = 1.0
incandescence_scale = 1.0
card_radiosity = true
card_tile_budget = 0               # 0: the grade's
# Reflections
reflections = true
ray_traced_reflections = true
reflection_bounces = 2
reflection_scale = 1.0
reflection_roughness = 0.8
mirror_filter = false              # measured option (Documentation/Plans/Ongoing/RayTracedLighting.md)
mirror_trace = false               # measured option, costly
# Sun & shadows
direct_shadow = true
ray_traced_shadows = true
firefly_filter = true
solar_disc = false                 # measured option
stratified_sun = false             # measured option
penumbra_filter = false            # measured option
# Denoising & antialiasing
variance_filter = true
temporal_aa = true
diffuse_wavelet_levels = 4
diffuse_tally_limit = 24
diffuse_minimum_weight = 0.08
diffuse_colour_sigma = 4.0
glossy_wavelet_levels = 3
glossy_tally_limit = 12
glossy_minimum_weight = 0.12
glossy_colour_sigma = 3.0
# Exposure
auto_exposure = true
exposure_ev = 0.12                 # this level's own
# Geometry
virtualized_geometry = false
virtualized_stream_slots = 0
# Debug views and timing
inspection_mode = 0
distance_inspection = 1            # view 6 reads: 1 normals, 2 steps, 3 light
live_refresh = true
target_rate = 60

[[records]]
identity = "rec_solar"
type = "Solar"
name = "Sun"
[records.configuration]
enabled = true
elevation_deg = 38.0
azimuth_deg = 132.0
illuminance_klx = 98.0
kelvin = 5778.0

[[records]]
identity = "rec_flare"
type = "OpticalFlare"
name = "Lens Flare"
parent = "rec_solar"
[records.configuration]
enabled = true
intensity = 0.62
aperture_blades = 7

[[records]]
identity = "rec_clouds"
type = "Clouds"
name = "Clouds"
[records.configuration]
enabled = true
local_volume = false
coverage = 0.42
base_altitude_m = 1750.0
thickness_m = 1350.0

[[records]]
identity = "rec_local_cloud"
type = "Clouds"
name = "Local Cloud"
[records.configuration]
enabled = false
local_volume = true

[[records]]
identity = "rec_local_fog"
type = "Fog"
name = "Local Volumetric Fog"
[records.configuration]
enabled = false
local_volume = true

[[records]]
identity = "rec_atmosphere"
type = "Atmosphere"
name = "Atmosphere"
[records.configuration]
enabled = true
rayleigh = 1.0
mie_turbidity = 2.3
ozone = 1.0

[[records]]
identity = "rec_stars"
type = "Stars"
name = "Stars"
[records.configuration]
enabled = true
hipparcos_count = 5000
magnitude_gain = 1.15

[[records]]
identity = "rec_moons"
type = "Moons"
name = "Moons"
[records.configuration]
enabled = true
primary_phase = 0.68
secondary_enabled = true

[[records]]
identity = "rec_planet_venus"
type = "Planet"
name = "Venus"
[records.configuration]
enabled = true
body = 0
apparent_diameter_deg = 0.80
brightness = 1.0
ring_system = false
atmosphere_shell = true

[[records]]
identity = "rec_planet_jupiter"
type = "Planet"
name = "Jupiter"
[records.configuration]
enabled = true
body = 1
apparent_diameter_deg = 1.26
brightness = 1.0
ring_system = false
atmosphere_shell = false

[[records]]
identity = "rec_planet_mars"
type = "Planet"
name = "Mars"
[records.configuration]
enabled = true
body = 2
apparent_diameter_deg = 0.69
brightness = 1.0
ring_system = false
atmosphere_shell = false

[[records]]
identity = "rec_planet_saturn"
type = "Planet"
name = "Saturn"
[records.configuration]
enabled = true
body = 3
apparent_diameter_deg = 1.03
brightness = 1.0
ring_system = true
atmosphere_shell = false

[[records]]
identity = "rec_fog"
type = "Fog"
name = "Height Fog"
[records.configuration]
enabled = true
local_volume = false
base_density = 0.012
height_falloff = 0.14

[[records]]
identity = "rec_force_field"
type = "ForceField"
name = "Force Field"
[records.configuration]
enabled = true
visualize = false
include_turbulence = true
centre_metres = [-20.0, 0.0, 8.0]
half_extents_metres = [20.0, 20.0, 8.0]
grid_resolution = 5
arrow_seconds = 0.5

[[records]]
identity = "rec_wind"
type = "Wind"
name = "Wind"
parent = "rec_force_field"
[records.configuration]
enabled = true
direction_deg = 45.0
speed_mps = 6.5
turbulence = 0.45

# The Lobby's one vehicle: the Control vehicle, parked in the middle of the studio and facing +X. It is drawn from the same ControlVehicle archives
# (Body, Tyre and Rim) as the hero of the VehicleHMI demo's Lobby.html, and the view the Lobby opens with is that demo's hero framing of it.
# A normal Vehicle record: Play drives it (W/A/S/D, Space, R puts it back here, C is the chase camera) and its four tyres feed the smoke.
# Every figure that is not written here is the Control vehicle's own default.
[[records]]
identity = "rec_vehicle"
type = "Vehicle"
name = "Control vehicle"
[records.configuration]
vehicle_name = "Control vehicle"
group = "Vehicles"
visible = true
physics = true
possessed = true
chase_camera = true
position_m = [0.0, 0.0, 0.0]
orientation_deg = [0.0, 0.0, 0.0]

[[records]]
identity = "rec_vehicle_tyre_fl"
type = "Tyre"
name = "Control vehicle Tyre FL"
parent = "rec_vehicle"
[records.configuration]
corner = 0
compound = "Medium"
set = "Set A"
cold_pressure_pa = 110000.0
enclosed = true

[[records]]
identity = "rec_vehicle_tyre_fr"
type = "Tyre"
name = "Control vehicle Tyre FR"
parent = "rec_vehicle"
[records.configuration]
corner = 1
compound = "Medium"
set = "Set A"
cold_pressure_pa = 110000.0
enclosed = true

[[records]]
identity = "rec_vehicle_tyre_rl"
type = "Tyre"
name = "Control vehicle Tyre RL"
parent = "rec_vehicle"
[records.configuration]
corner = 2
compound = "Medium"
set = "Set A"
cold_pressure_pa = 110000.0
enclosed = true

[[records]]
identity = "rec_vehicle_tyre_rr"
type = "Tyre"
name = "Control vehicle Tyre RR"
parent = "rec_vehicle"
[records.configuration]
corner = 3
compound = "Medium"
set = "Set A"
cold_pressure_pa = 110000.0
enclosed = true
