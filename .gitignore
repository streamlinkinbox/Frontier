# Vendored dependencies (Vulkan, volk, VMA, glm, imgui, slang, stb, etc.) — not our source.
ExternalPackages/

# Build outputs and intermediates.
Build/
build/
# 📝 Packages stay local, except the Scene Viewport's Windows download, which the branch carries so the owner can take
#    it from GitHub (Arena's GitHub App may not add workflow files, and its sandbox cannot reach uploads.github.com).
Binaries/*
!Binaries/FrontierSceneViewport-Windows-x64.zip
!Binaries/FrontierSceneViewport-Windows-x64.zip.sha256

# Sample meshes / textures / assets — tracked separately.
EngineContent/*
!EngineContent/Icons/
!EngineContent/README.md
!EngineContent/Defaults/
!EngineContent/MaterialArchives/
!EngineContent/PatternArchives/
# The Particle editor's preset library (Automation/ExportParticleLibrary.mjs).
!EngineContent/ParticleArchives/
!EngineContent/EnvironmentArchives/
!EngineContent/ShaderArchives/
# The engine shapes (Construct › Geometry) and their baked distance volumes (Exhibits/SceneViewport/Code/ShapeArchiveBake.cpp).
!EngineContent/ShapeArchives/
EngineContent/EnvironmentArchives/CelestialMaps/*.ppm

# Agent scratch space.
_ClaudeScratch/

# Diagnostic logs dropped beside built exes.
*.log

# Compiled shader blobs (ShaderPlan.ps1 / glslc output) and the make-style include depfiles glslc -MD writes beside them.
*.spv
*.spv.d
# The Scene Viewport's stored SPIR-V (Automation/StoreShaderArchives.py): editor builds without the pinned slangc still run it.
!EngineContent/ShaderArchives/**/*.spv

# OS / editor cruft.
.DS_Store
Thumbs.db
*.swp

# Python tooling intermediates.
__pycache__/
*.pyc

# Downloaded open fonts and generated catalogue; recover with Automation/PrepareFonts.py.
EngineContent/FontArchives/

# Compile-time automatically staged EngineContent imports inside <Project>/Content/.
Projects/*/Content/FontArchives/
Projects/*/Content/Icons/
Projects/*/Content/Defaults/
Projects/*/Content/EnvironmentArchives/
Projects/*/Content/MaterialArchives/
Projects/*/Content/PatternArchives/
Projects/*/Content/.staged_manifest.json

# Overlay (Frontier/ portable engine) outputs and local state.
_AgentScratch/
**/Build/Output/
**/ThirdParty/
*.local.*
.env
*.obj
*.pdb
*.exe
*.dll
*.lib
/google_drive/
**/Saved/

# The Zig toolchain configure writes CMake's standard-library probe to a file named "-" in the source root.
/-
