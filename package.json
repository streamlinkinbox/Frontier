{
  "name": "frontier-terrain-lab",
  "private": true,
  "version": "0.12.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build:pages": "tsc -b && vite build --base=./",
    "publish:pages": "npm run build:pages && node scripts/publish-pages.mjs",
    "check:pages": "node scripts/check-pages.mjs",
    "test:pages": "npm run publish:pages && playwright test --config=playwright.pages.config.ts",
    "build:satmaps": "node --experimental-strip-types scripts/build-satmaps.mjs",
    "dev:material": "vite --mode material-lab --host 0.0.0.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@webgpu/types": "^0.1.60",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.4",
    "typescript": "~5.7.2",
    "vite": "^6.1.0",
    "vitest": "^3.0.7"
  }
}
