+            B.Vertex(P0, Slant(R0)); B.Vertex(P1, Slant(R1)); B.Vertex(Apex, Slant(Rm)); B.Triangle(K, K + 1, K + 2);
             K = B.Surface.VertexCount();
             B.Vertex(P1, Axis * -1.0); B.Vertex(P0, Axis * -1.0); B.Vertex(Foot, Axis * -1.0); B.Triangle(K, K + 1, K + 2);    // cap
         }
