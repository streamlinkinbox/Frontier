+EditorProperty* FindProperty(EditorPropertyGroup& Group, const char* Label) noexcept
+{
+    for (uint32_t I = 0u; I < Group.PropertyCount; ++I)
+        if (std::strcmp(Group.Properties[I].Label, Label) == 0)
+            return &Group.Properties[I];
