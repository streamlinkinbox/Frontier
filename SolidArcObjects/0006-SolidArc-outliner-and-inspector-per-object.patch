+    L.Draw->PathArcTo(C, 4.2f, 0.6f, 5.6f, 14);
+    L.Draw->PathStroke(kDim, 0, 1.3f);
+    Text(L, 11.0f, ImVec2(Min.x + 27.0f, Min.y + 6.0f), kInk, Label);
