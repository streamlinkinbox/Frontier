+//------------------------------------------------------------------------------------------------------------------------
+//                                                     PROPERTY ROWS
+//------------------------------------------------------------------------------------------------------------------------
+
+struct AxisRange
+{
+    const char* Label;
+    const char* Unit;
+    float       Step;
+    int         Decimals;
+    float       Low;
+    float       High;
+};
+
+constexpr AxisRange kAxisRanges[] =
+{
+    { "Position", "m",   0.01f,  3, -10.0f,  10.0f },
+    { "Rotation", "deg", 0.40f,  1, -180.0f, 180.0f },
+    { "Scale",    "x",   0.005f, 3,  0.1f,   4.0f },
+};
+
+AxisRange RangeFor(const char* Label, float Step) noexcept
+{
+    for (const AxisRange& Range : kAxisRanges)
+        if (std::strcmp(Range.Label, Label) == 0)
+            return Range;
+    return AxisRange{ Label, "", Step, 3, -10.0f, 10.0f };
+}
+
+void RowAxis(Layout& L, EditorProperty& Property) noexcept
+{
+    const AxisRange Range = RangeFor(Property.Label, Property.AxisStep > 0.0f ? Property.AxisStep : 0.05f);
+    ImGui::PushID(Property.Label);
+    Caps(L, ImVec2(L.InnerX(), L.Y), kDim, Property.Label);
+    if (Range.Unit[0] != '\0')
+    {
+        const float UnitW = TextWidth(L, 10.0f, Range.Unit);
+        Text(L, 10.0f, ImVec2(L.InnerX() + L.InnerW() - UnitW, L.Y), kFaint, Range.Unit);
+    }
+    L.Y += 17.0f;
+
+    // One row per axis: the axis badge, the slider track, the numeric field. The track drops out for read-only rows.
+    const float FieldW = std::min(70.0f, L.InnerW() * 0.42f);
+    const float FieldX = L.InnerX() + L.InnerW() - FieldW;
+    for (int Axis = 0; Axis < 3; ++Axis)
+    {
+        char Id[16] = {};
+        const ImVec2 Badge(L.InnerX() + 11.0f, L.Y + kCell * 0.5f);
+        L.Draw->AddCircleFilled(Badge, 10.0f, WithAlpha(kAxis[Axis], Property.Editable ? 46 : 22));
+        const float LetterW = TextWidth(L, 11.0f, kLetter[Axis]);
+        Text(L, 11.0f, ImVec2(Badge.x - LetterW * 0.5f, Badge.y - 6.0f), Property.Editable ? kAxis[Axis] : kDim, kLetter[Axis]);
+        if (Property.Editable)
+        {
+            std::snprintf(Id, sizeof(Id), "##t%d", Axis);
+            AxisTrack(L, Id, ImVec2(L.InnerX() + 26.0f, L.Y), FieldX - 6.0f - (L.InnerX() + 26.0f), &Property.Axes[Axis], Range.Low, Range.High, Axis);
+        }
+        std::snprintf(Id, sizeof(Id), "##c%d", Axis);
+        NumberCell(L, Id, ImVec2(FieldX, L.Y), FieldW, &Property.Axes[Axis], Range.Step, Range.Decimals, Axis, Property.Editable);
+        L.Y += kCell + 4.0f;
+    }
+    L.Y += 8.0f;
+    ImGui::PopID();
+}
+
+void RowSlider(Layout& L, EditorProperty& Property) noexcept
+{
+    ImGui::PushID(Property.Label);
+    Text(L, 12.0f, ImVec2(L.InnerX(), L.Y), kDim, Property.Label);
+    ImGui::SetCursorScreenPos(ImVec2(L.InnerX(), L.Y + 20.0f));
+    ImGui::BeginChild("##slider", ImVec2(L.InnerW(), 30.0f), false, ImGuiWindowFlags_NoScrollbar | ImGuiWindowFlags_NoScrollWithMouse);
+    if (L.Controls->SliderPill("##v", &Property.Figure, Property.Minimum, Property.Maximum, Property.Decimals, Property.Unit,
+                               Property.Hi, false, true))
+    {
+        if (!std::isfinite(Property.Figure))
+            Property.Figure = Property.Minimum;
+        Property.Figure = std::clamp(Property.Figure, Property.Minimum, Property.Maximum);
+    }
+    ImGui::EndChild();
+    ImGui::PopID();
+    L.Y += 58.0f;
+}
+
+void RowSwitch(Layout& L, EditorProperty& Property) noexcept
+{
+    ImGui::PushID(Property.Label);
+    Text(L, 12.5f, ImVec2(L.InnerX(), L.Y + 6.0f), kInk, Property.Label);
+    ImGui::SetCursorScreenPos(ImVec2(L.InnerX() + L.InnerW() - 46.0f, L.Y));
+    ImGui::BeginChild("##switch", ImVec2(46.0f, 26.0f), false, ImGuiWindowFlags_NoScrollbar | ImGuiWindowFlags_NoScrollWithMouse);
+    L.Controls->Switch("##s", &Property.On);
+    ImGui::EndChild();
+    ImGui::PopID();
+    L.Y += 34.0f;
+}
+
+void RowSelect(Layout& L, EditorProperty& Property) noexcept
+{
+    ImGui::PushID(Property.Label);
