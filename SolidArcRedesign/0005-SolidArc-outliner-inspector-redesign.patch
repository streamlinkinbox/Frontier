+// The slider beside an axis field: a thin track, a fill in the axis tint, a knob.
+bool AxisTrack(Layout& L, const char* Id, const ImVec2& Min, float Width, float* Value, float Low, float High, int Axis) noexcept
+{
+    ImGui::SetCursorScreenPos(ImVec2(Min.x, Min.y));
+    ImGui::InvisibleButton(Id, ImVec2(Width, kCell));
+    bool Changed = false;
+    if (ImGui::IsItemActive())
+    {
+        const float T = std::clamp((ImGui::GetIO().MousePos.x - Min.x - 6.0f) / std::max(1.0f, Width - 12.0f), 0.0f, 1.0f);
+        const float V = Low + (High - Low) * T;
+        if (V != *Value)
+        {
+            *Value  = V;
+            Changed = true;
+        }
+    }
+    const float T = std::clamp((*Value - Low) / (High - Low), 0.0f, 1.0f);
+    const float Cy = Min.y + kCell * 0.5f;
+    const float X0 = Min.x + 6.0f, X1 = Min.x + Width - 6.0f;
+    const float Kx = X0 + (X1 - X0) * T;
+    L.Draw->AddRectFilled(ImVec2(X0, Cy - 1.5f), ImVec2(X1, Cy + 1.5f), IM_COL32(255, 255, 255, 24), 2.0f);
+    L.Draw->AddRectFilled(ImVec2(X0, Cy - 1.5f), ImVec2(Kx, Cy + 1.5f), WithAlpha(kAxis[Axis], 190), 2.0f);
+    L.Draw->AddCircleFilled(ImVec2(Kx, Cy), 5.5f, kInk);
+    L.Draw->AddCircle(ImVec2(Kx, Cy), 5.5f, kAxis[Axis], 20, 1.5f);
+    return Changed;
+}
