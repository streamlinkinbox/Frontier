+        std::fprintf(stderr, "[SolidArcEditorProof] Transform axis marks: red %d, green %d, blue %d\n", Reds, Greens, Blues);
+        if (Reds < 12)   Fail("the Transform card shows no red X axis mark");
+        if (Greens < 12) Fail("the Transform card shows no green Y axis mark");
+        if (Blues < 12)  Fail("the Transform card shows no blue Z axis mark");
+
+        // The fields edit the figure: a drag across Position X moves the body, the Scale X slider scales it about its pivot.
+        const Frontier::Box3 Before = BodyBox();
+        Drag(1200.0f, 1230.0f, 260.0f);
+        const Frontier::Box3 Moved = BodyBox();
+        std::fprintf(stderr, "[SolidArcEditorProof] Position drag: centre X %.3f -> %.3f\n", Before.Centre().X, Moved.Centre().X);
+        if (Moved.Centre().X - Before.Centre().X < 0.15)
+            Fail("dragging the Position X field did not move the body");
+        Drag(1130.0f, 1190.0f, 502.0f);
+        const Frontier::Box3 Scaled = BodyBox();
+        std::fprintf(stderr, "[SolidArcEditorProof] Scale X slider: extent X %.3f -> %.3f, centre X %.3f -> %.3f\n",
+                     Moved.Extent().X, Scaled.Extent().X, Moved.Centre().X, Scaled.Centre().X);
+        if (Scaled.Extent().X < Moved.Extent().X * 1.5)
+            Fail("the Scale X slider did not scale the body");
+        if (std::fabs(Scaled.Centre().X - Moved.Centre().X) > 1e-3)
+            Fail("scaling moved the body's pivot");
+
+        // The sheet scrolls to the cards below the fold.
+        for (int I = 0; I < 2; ++I)
+        {
+            IO.AddMouseWheelEvent(0.0f, -6.0f);
+            Tick(1100.0f, 300.0f, false);
+        }
+        for (int I = 0; I < 4; ++I)
+            Rest();
+        Rasterise();
+        const char* MidShot = "Exhibits/Gallery/Editor/EditorProof_SolidArc_InspectorMid.png";
+        if (const int Write = WriteSheet(MidShot, 8); Write != 0)
+            return Write;
+        for (int I = 0; I < 6; ++I)
+        {
+            IO.AddMouseWheelEvent(0.0f, -6.0f);
+            Tick(1100.0f, 300.0f, false);
+        }
+        for (int I = 0; I < 4; ++I)
+            Rest();
+        Rasterise();
+        const char* EndShot = "Exhibits/Gallery/Editor/EditorProof_SolidArc_InspectorEnd.png";
+        if (const int Write = WriteSheet(EndShot, 8); Write != 0)
+            return Write;
+        if (Failed)
+            return 16;
+        std::fprintf(stderr, "[SolidArcEditorProof] inspector gates GREEN: glass cards, XYZ fields and sliders edit the figure\n");
+    }
     ImGui::DestroyContext();
     return 0;
 }
