+
+// A status pill: a dot, a label. With a toggle it reads on/off by the dot; without it is a plain chip.
+bool Pill(Layout& L, const char* Id, float X, float Y, const char* Label, bool On, ImU32 Dot, bool Toggle) noexcept
+{
+    const float W = PillWidth(L, Label);
+    ImGui::SetCursorScreenPos(ImVec2(X, Y));
+    const bool Hit = ImGui::InvisibleButton(Id, ImVec2(W, 24.0f)) && Toggle;
+    const bool Hot = ImGui::IsItemHovered() && Toggle;
+    L.Draw->AddRectFilled(ImVec2(X, Y), ImVec2(X + W, Y + 24.0f), Hot ? kTileHot : kTile, 12.0f);
+    L.Draw->AddRect(ImVec2(X, Y), ImVec2(X + W, Y + 24.0f), kHair, 12.0f);
+    L.Draw->AddCircleFilled(ImVec2(X + 13.0f, Y + 12.0f), 3.5f, On ? Dot : kFaint);
+    Text(L, 10.5f, ImVec2(X + 22.0f, Y + 6.0f), On ? kInk : kDim, Label);
+    return Hit;
+}
