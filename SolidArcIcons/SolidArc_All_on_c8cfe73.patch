+float CapsWidth(Layout& L, const char* Value) noexcept
+{
+    float W = 0.0f;
+    for (const char* P = Value; *P != '\0'; )
+    {
+        char One[5] = {};
+        const size_t Length = Utf8Length(P);
+        for (size_t I = 0u; I < Length && P[I] != '\0'; ++I)
+            One[I] = P[I];
+        W += L.Ui->CalcTextSizeA(10.0f, FLT_MAX, 0.0f, One).x + 1.2f;
+        P += Length;
+    }
+    return W;
+}
